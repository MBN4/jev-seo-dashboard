# Copy to .env.local and adjust. .env.local is git-ignored.
# (Older JEVSEO_* names are still accepted for the same settings.)

# Folder of the audit engine checkout (default: ../jev-seo next to this folder)
RANKORA_ENGINE_DIR=../jev-seo
# Python interpreter with the engine's requirements (default: <engine>/.venv/bin/python)
# RANKORA_ENGINE_PYTHON=/home/you/engine/.venv/bin/python
# Where audit folders live (default: the engine's own output folder)
# RANKORA_REPORTS_DIR=/home/you/engine/reports
# Rankora state: app-state JSON, secrets.env (mode 600), job logs, branded reports (default: ./data)
# RANKORA_DATA_DIR=./data
# Simultaneous audits (1-4, default 1)
# RANKORA_MAX_CONCURRENT=1
# Hard wall-clock limit per audit process, seconds (default 7200)
# RANKORA_MAX_AUDIT_SECONDS=7200
# Extra hostnames allowed to reach the dashboard (default: localhost only)
# RANKORA_ALLOWED_HOSTS=

# Branding (rebuild after changing: npm run build)
# NEXT_PUBLIC_BRAND_NAME=Rankora
# NEXT_PUBLIC_BRAND_TAGLINE=SEO audit workspace

# API keys are best entered in Settings > API keys (stored in data/secrets.env).
# Keys already in the engine's .env or your environment are detected automatically.
