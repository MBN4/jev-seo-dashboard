# Copy to .env.local and adjust. .env.local is git-ignored.

# Path to your jev-seo engine checkout (default: ../jev-seo next to this folder)
JEVSEO_DIR=../jev-seo
# Python interpreter that has the engine requirements (default: $JEVSEO_DIR/.venv/bin/python)
# JEVSEO_PYTHON=/home/you/jev-seo/.venv/bin/python
# Where audit folders live (default: $JEVSEO_DIR/jev-seo-reports, same as the CLI)
# JEVSEO_REPORTS_DIR=/home/you/jev-seo/jev-seo-reports
# Dashboard state: app-state JSON, secrets.env (mode 600), job logs (default: ./data)
# JEVSEO_DATA_DIR=./data
# Simultaneous audits (1-4, default 1)
# JEVSEO_MAX_CONCURRENT=1
# Hard wall-clock limit per audit process, seconds (default 3600)
# JEVSEO_MAX_AUDIT_SECONDS=3600
# Extra hostnames allowed to reach the dashboard (default: localhost only)
# JEVSEO_ALLOWED_HOSTS=

# API keys are best entered in Settings > API keys (stored in data/secrets.env).
# Keys already in your engine's .env or environment are detected automatically.
